# Copy this file to .env and fill in the keys for the models you want to race.
# .env is ignored by git. A variable already set in your shell takes precedence.

# Jev at TypeSafe: uv run decision-arena --players jev
TYPESAFE_API_KEY=

# OpenAI's Decisions API (an API key; a ChatGPT sign-in doesn't work): --players openai
OPENAI_API_KEY=

# Perplexity's Decisions API: --players perplexity
PERPLEXITY_API_KEY=

# Laya runs on this computer and needs no key, and bots need nothing at all.
